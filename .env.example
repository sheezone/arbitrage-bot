# Telegram bot token from @BotFather
BOT_TOKEN=

# Odds provider API key (see README for how to get one)
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.oddspapi.io

# the-odds-api.com key, used only for basketball_nba (free tier: 500 requests/month)
THE_ODDS_API_KEY=

# Payment provider token for card payments (RUB), issued by @BotFather after connecting
# YooKassa under Bot Settings -> Payments. Leave empty to only offer Telegram Stars.
YOOKASSA_PROVIDER_TOKEN=

# surebet.com API token. Leave empty to use the public test token (<=1% margin surebets
# only, ~1 req/min). Set this if you buy real access (100 EUR/bookmaker/month).
SUREBET_API_TOKEN=

# Comma-separated Telegram chat_ids that bypass the trial/subscription check entirely
# (unlimited access). Find your own chat_id via @userinfobot.
ADMIN_CHAT_IDS=

# Chat id of a public group/channel where the bot posts a teaser (game + profit%, no
# bookmakers/odds) for every found arbitrage, to attract new subscribers. Add the bot as
# admin there first, then get the chat_id via @userinfobot (forward a message from the
# channel to it) or by checking getUpdates after posting in the group. Leave empty to disable.
SHOWCASE_CHAT_ID=

# Minimum seconds between showcase posts, even if more arbitrages are found in between.
SHOWCASE_INTERVAL_SECONDS=600

# How often to poll for new odds, in seconds (Fonbet/PARI dumps are ~7MB, keep this conservative)
POLL_INTERVAL_SECONDS=150

# Default minimum profit % required to send a notification
DEFAULT_MIN_PROFIT_PCT=1.0

# Where to store the sqlite database file
DB_PATH=arbitrage_bot.sqlite3

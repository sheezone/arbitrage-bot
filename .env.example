# Telegram bot token from @BotFather
BOT_TOKEN=

# Odds provider API key (see README for how to get one)
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.oddspapi.io

# the-odds-api.com key, used only for basketball_nba (free tier: 500 requests/month)
THE_ODDS_API_KEY=

# Payment provider token for card payments (RUB), issued by @BotFather after connecting
# YooKassa under Bot Settings -> Payments. Leave empty to only offer Telegram Stars.
YOOKASSA_PROVIDER_TOKEN=

# How often to poll for new odds, in seconds (Fonbet/PARI dumps are ~7MB, keep this conservative)
POLL_INTERVAL_SECONDS=150

# Default minimum profit % required to send a notification
DEFAULT_MIN_PROFIT_PCT=1.0

# Where to store the sqlite database file
DB_PATH=arbitrage_bot.sqlite3
